HOUSECALL_PRO_API_KEY=replace-me
HOUSECALL_PRO_AUTH_SCHEME=auto
HOUSECALL_PRO_BASE_URL=https://api.housecallpro.com
# Optional: scope requests to a specific sub-location in multi-location accounts
HOUSECALL_PRO_COMPANY_ID=
HOUSECALL_PRO_CUSTOMERS_PATH=/customers
HOUSECALL_PRO_CUSTOMER_PATH=/customers/{customerId}
HOUSECALL_PRO_JOBS_PATH=/jobs
HOUSECALL_PRO_JOB_PATH=/jobs/{jobId}
HOUSECALL_PRO_ESTIMATES_PATH=/estimates
HOUSECALL_PRO_ESTIMATE_PATH=/estimates/{estimateId}
HOUSECALL_PRO_INVOICES_PATH=/invoices
HOUSECALL_PRO_INVOICE_PATH=/invoices/{invoiceId}
HOUSECALL_PRO_JOB_INVOICES_PATH=/jobs/{jobId}/invoices
HOUSECALL_PRO_LEADS_PATH=/leads
HOUSECALL_PRO_BEARER_TOKEN=

# Optional OAuth refresh (auto-refreshes access token on 401)
HOUSECALL_PRO_OAUTH_CLIENT_ID=
HOUSECALL_PRO_OAUTH_CLIENT_SECRET=
HOUSECALL_PRO_OAUTH_REFRESH_TOKEN=
HOUSECALL_PRO_OAUTH_REDIRECT_URI=

# Max retries on HTTP 429 rate limits (default: 3)
HOUSECALL_PRO_RATE_LIMIT_MAX_RETRIES=3

# Webhook ingress (HTTP server only — POST /webhooks/housecall)
HOUSECALL_PRO_WEBHOOK_SIGNING_SECRET=
# Dev only: skip HMAC verification (never use in production)
HOUSECALL_PRO_WEBHOOK_SKIP_VERIFY=false
# Max webhook events kept in memory (default 500)
HOUSECALL_PRO_WEBHOOK_MAX_EVENTS=500
